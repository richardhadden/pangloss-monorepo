        "plural": "Alternativen",
        // en: One of several things, not known which: any number of statements or entities.
        //     `Alternative[ViaEdge[Person, Probability]]` gives each person how likely it is the one meant
        "description": "Eines von mehreren Dingen, unbekannt welches: beliebig viele Aussagen oder Entitäten. `Alternative[ViaEdge[Person, Probability]]` gibt jeder Person an, wie wahrscheinlich sie die gemeinte ist",
        "help": "",
        "fields": {
          "alternatives": {
            // en: Alternatives
            "name": "Alternativen",
            "plural": "",
            "help": ""
          }
        }

    "Alternative": {
      "en": {
        "name": "Alternative",
        "plural": "Alternatives",
        "description": "One of several things, not known which: any number of statements or entities.\n`Alternative[ViaEdge[Person, Probability]]` gives each person how likely it is the one meant",

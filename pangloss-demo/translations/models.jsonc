        "name": "Ongoing date",
        "plural": "Ongoing dates"
      },
      "de": {
        "name": "Laufendes Datum",
        "description": "Das Ende eines Zeitraums, der noch nicht zu Ende ist (er gilt als beendet bis zum Ende von `DATES_OPEN_END_YEAR`)"
      },
      "fr": {
        "name": "Date en cours",
        "plural": "Dates en cours",
        "description": "La fin d’une période qui n’est pas terminée (elle est réputée s’arrêter à la fin de `DATES_OPEN_END_YEAR`)"
      }
    },
    "Period": {
      "en": {
        "name": "Period",
        "plural": "Periods"
      },
      "de": {

    "Recurrence": {
      "en": {
        "name": "Recurrence",
        "plural": "Recurrences",
        "fields": {
          "easter_offset": {
            "name": "Offset from Easter"
          }
        }
      },
      "de": {
        "name": "Wiederkehr",
        "description": "Etwas, das innerhalb einer Lebenszeit (`start` bis `end`) immer wieder geschieht: „jeden Sonntag“, „der dritte\nSonntag im März“, „am 21. jedes Monats“. Die Tage werden nie gespeichert; `pattern_keys` finden die Regeln,\ndie auf einen Tag fallen könnten (siehe `pangloss_dates.recurrence`)",
        "fields": {
          "frequency": {
            "name": "Häufigkeit"
          },
          "weekdays": {
            "name": "Wochentage"
          },
          "nth": {
            "name": "N-ter"
          },
          "month": {
            "name": "Monat"
          },
          "month_day": {
            "name": "Monatstag"
          },
          "interval": {
            "name": "Intervall"
          },
          "excluded_days": {
            "name": "Ausgenommene Tage"
          },
          "leap_shift": {
            "name": "Schaltverschiebung"
          },
          "easter_offset": {
            "name": "Abstand zu Ostern"
          },
          "feast": {
            "name": "Fest"
          },
          "start": {
            "name": "Beginn"
          },
          "end": {
            "name": "Ende"
          },
          "pattern_keys": {
            "name": "Musterschlüssel"
          }
        }
      },
      "fr": {
        "name": "Récurrence",
        "plural": "Récurrences",
        "description": "Quelque chose qui se répète au cours d’une vie (de `start` à `end`) : « chaque dimanche », « le troisième dimanche de mars », « le 21 de chaque mois ». Les jours ne sont jamais enregistrés ; `pattern_keys` retrouvent les règles qui pourraient tomber un jour donné (voir `pangloss_dates.recurrence`)",
        "fields": {
          "frequency": {
            "name": "Fréquence"
          },
          "weekdays": {
            "name": "Jours de la semaine"
          },
          "nth": {
            "name": "N-ième"
          },
          "month": {
            "name": "Mois"
          },
          "month_day": {
            "name": "Jour du mois"
          },
          "interval": {
            "name": "Intervalle"
          },
          "excluded_days": {
            "name": "Jours exclus"
          },
          "leap_shift": {
            "name": "Décalage bissextile"
          },
          "easter_offset": {
            "name": "Décalage par rapport à Pâques"
          },
          "feast": {
            "name": "Fête"
          },
          "start": {
            "name": "Début"
          },
          "end": {
            "name": "Fin"
          },
          "pattern_keys": {
            "name": "Clés de motif"
          }
        }
      }
    },
    "UnknownDate": {
      "en": {
        "name": "Unknown date",
        "plural": "Unknown dates"
      },
      "de": {
        "name": "Unbekanntes Datum",
        "description": "Der Beginn oder das Ende eines Zeitraums, den niemand kennt. Er ist offen von `DATES_EARLIEST_YEAR` bis\n`DATES_OPEN_END_YEAR`, sodass der Zeitraum dennoch über ein Datum gefunden wird, das er enthalten könnte. Sagen Sie, was bekannt ist,\nwenn irgendetwas bekannt ist: ein Bereich mit einer vernünftigen Schätzung (`DateRange` oder EDTF `1500~`) sagt mehr, ein\nunbekanntes Datum nur, dass nichts bekannt ist. Beide Enden eines Zeitraums können nicht unbekannt sein."
      },
      "fr": {
        "name": "Date inconnue",
        "plural": "Dates inconnues",
        "description": "Le début ou la fin d’une période que personne ne connaît. Elle est ouverte de `DATES_EARLIEST_YEAR` à `DATES_OPEN_END_YEAR`, de sorte que la période est tout de même trouvée par une date qu’elle pourrait inclure. Dites ce qui est connu, si quelque chose l’est : un intervalle avec une estimation raisonnable (`DateRange` ou EDTF `1500~`) en dit plus, une date inconnue dit seulement que rien n’est connu. Les deux bouts d’une période ne peuvent pas être inconnus."
      }
    }
  },

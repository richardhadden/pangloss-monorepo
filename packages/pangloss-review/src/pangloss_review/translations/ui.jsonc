  "review_similar_none": { "en": "No other mention is like this one", "de": "Keine andere Erwähnung ähnelt dieser", "fr": "Aucune autre mention ne ressemble à celle-ci" },
  "review_similar_help": { "en": "These may be the same: they name the same URI or have the same label (ticked), or one much like it. Those ticked are reconciled with it as well.", "de": "Diese könnten dasselbe meinen: Sie nennen dieselbe URI oder haben dieselbe Bezeichnung (markiert) oder eine sehr ähnliche. Die markierten werden ebenfalls damit abgeglichen.", "fr": "Celles-ci sont peut-être les mêmes : elles citent le même URI ou ont le même libellé (cochées), ou un libellé très proche. Celles cochées sont rapprochées elles aussi." },
  "review_reconcile": { "en": "Reconcile", "de": "Abgleichen", "fr": "Rapprocher" },
  "review_reconcile_title": { "en": "Reconcile", "de": "Abgleichen", "fr": "Rapprocher" },
  "review_reconcile_named": { "en": "Reconcile {label}", "de": "{label} abgleichen", "fr": "Rapprocher {label}" },
  "review_reconcile_with": { "en": "Reconcile with", "de": "Abgleichen mit", "fr": "Rapprocher de" },
  "review_find_entity": { "en": "Find {type}, or + to make one", "de": "{type} suchen, oder + zum Anlegen", "fr": "Chercher {type}, ou + pour en créer" },

  "review_mentions_search": { "en": "Search the mentions", "de": "Erwähnungen durchsuchen", "fr": "Chercher dans les mentions" },
  "review_identifications_title": { "en": "Identifications to confirm", "de": "Zu bestätigende Identifizierungen", "fr": "Identifications à confirmer" },
  "review_suggestions_count": { "en": "To confirm: {count}", "de": "Zu bestätigen: {count}", "fr": "À confirmer : {count}" },
  "review_suggestion": { "en": "Suggestion", "de": "Vorschlag", "fr": "Suggestion" },
  "review_suggested_by": { "en": "Suggested by", "de": "Vorgeschlagen von", "fr": "Suggéré par" },
  "review_confirm": { "en": "Confirm", "de": "Bestätigen", "fr": "Confirmer" },
  "review_confirm_title": { "en": "Confirm an identification", "de": "Identifizierung bestätigen", "fr": "Confirmer une identification" },
  "review_confirm_help": { "en": "Confirming says that you have checked it: it becomes your identification.", "de": "Mit der Bestätigung erklären Sie, dass Sie es geprüft haben: Es wird zu Ihrer Identifizierung.", "fr": "Confirmer, c’est dire que vous l’avez vérifiée : elle devient votre identification." },
  "review_confirm_help_by": { "en": "Suggested by {toolchain}. Confirming says that you have checked it: it becomes your identification.", "de": "Vorgeschlagen von {toolchain}. Mit der Bestätigung erklären Sie, dass Sie es geprüft haben: Es wird zu Ihrer Identifizierung.", "fr": "Suggérée par {toolchain}. Confirmer, c’est dire que vous l’avez vérifiée : elle devient votre identification." },
  "review_given_to_others": { "en": "{count} more are being given the same, in the background", "de": "{count} weitere erhalten im Hintergrund dasselbe", "fr": "{count} autres reçoivent la même identification en arrière-plan" },
  "review_confirmed_in_form": { "en": "Confirmed: it is saved with the document", "de": "Bestätigt: wird mit dem Dokument gespeichert", "fr": "Confirmé : enregistré avec le document" },
  "review_has_uri": { "en": "has this URI already", "de": "hat diese URI bereits", "fr": "a déjà cet URI" },
  "review_done_in_form": { "en": "{count} more in this document are done with it", "de": "{count} weitere in diesem Dokument werden mit erledigt", "fr": "{count} autres dans ce document sont traitées avec" },
  "review_same_uri_suggestions_help": { "en": "These identifications suggested by a toolchain name the same URI. Those ticked are confirmed as who it is reconciled with.", "de": "Diese von einer Toolchain vorgeschlagenen Identifizierungen nennen dieselbe URI. Die markierten werden als der abgeglichene Eintrag bestätigt.", "fr": "Ces identifications suggérées par une chaîne d’outils citent le même URI. Celles cochées sont confirmées comme l’élément rapproché." },
  "review_same_uri_mentions_help": { "en": "These unreconciled mentions name the same URI. Those ticked are reconciled with {label}.", "de": "Diese nicht abgeglichenen Nennungen nennen dieselbe URI. Die markierten werden mit {label} abgeglichen.", "fr": "Ces mentions non rapprochées citent le même URI. Celles cochées sont rapprochées de {label}." },
  "review_uri_known": { "en": "Its URI is already that of someone who is not among the candidates:", "de": "Seine URI gehört bereits zu einem Eintrag, der nicht unter den Kandidaten ist:", "fr": "Son URI est déjà celui d’un élément qui n’est pas parmi les candidats :" },
  "review_in_this_document": { "en": "in this document", "de": "in diesem Dokument", "fr": "dans ce document" },
  "review_same_uri": { "en": "same URI", "de": "gleiche URI", "fr": "même URI" },
  "review_confirm_refused": { "en": "Not confirmed: {reason}", "de": "Nicht bestätigt: {reason}", "fr": "Non confirmé : {reason}" },
  "review_similar_suggestions_none": { "en": "No other suggestion says the same", "de": "Kein anderer Vorschlag besagt dasselbe", "fr": "Aucune autre suggestion ne dit la même chose" },
  "review_similar_suggestions_help": { "en": "These are of the same person: they name the same URI (ticked), or suggest the same candidates, about as likely. Those ticked are given the same identification: in this document with it, in others now, in the background.", "de": "Diese betreffen dieselbe Person: Sie nennen dieselbe URI (markiert) oder schlagen dieselben Kandidaten mit ähnlicher Wahrscheinlichkeit vor. Die markierten erhalten dieselbe Identifizierung: in diesem Dokument zugleich, in anderen jetzt im Hintergrund.", "fr": "Celles-ci concernent la même personne : elles citent le même URI (cochées) ou proposent les mêmes candidats, à peu près aussi probables. Celles cochées reçoivent la même identification : dans ce document en même temps, dans les autres maintenant, en arrière-plan." },
  "review_select_all": { "en": "All of them", "de": "Alle", "fr": "Toutes" },
  "review_also_confirm": { "en": "This one too", "de": "Diesen auch", "fr": "Celle-ci aussi" },
  "nav_pangloss_review_review": { "en": "Review", "de": "Prüfung", "fr": "Relecture" }
}

  "review_reconciled_in_form": { "en": "Reconciled with {label}: it is saved with the document", "de": "Mit {label} abgeglichen: wird mit dem Dokument gespeichert", "fr": "Rapproché de {label} : enregistré avec le document" },
  "review_reconciling_others": { "en": "{count} more are being reconciled, in the background", "de": "{count} weitere werden im Hintergrund abgeglichen", "fr": "{count} autres sont rapprochées en arrière-plan" },
  "review_reconciled_more": { "en": "Reconciled with {label}; {count} more in the background", "de": "Abgeglichen mit {label}; {count} weitere im Hintergrund", "fr": "Rapproché de {label} ; {count} autres en arrière-plan" },
  "review_reconcile_refused": { "en": "Not reconciled: {reason}", "de": "Nicht abgeglichen: {reason}", "fr": "Non rapproché : {reason}" },
  "review_uris": { "en": "URIs to give: {uris}", "de": "Zu übertragende URIs: {uris}", "fr": "URI à donner : {uris}" },
  "review_check_in_form": { "en": "Check it in the form", "de": "Im Formular prüfen", "fr": "Vérifier dans le formulaire" },
  "review_uris_warning": { "en": "Confirming gives these URIs to this one, when the document is saved. Check that it is the right one.", "de": "Mit der Bestätigung werden diese URIs beim Speichern des Dokuments diesem Eintrag übertragen. Prüfen Sie, ob es der richtige ist.", "fr": "La confirmation donne ces URI à cet élément, à l’enregistrement du document. Vérifiez que c’est le bon." },
  "review_confirm_identification": { "en": "Confirm identification", "de": "Identifizierung bestätigen", "fr": "Confirmer l’identification" },
  "review_outstanding_unreconciled": { "en": "Outstanding unreconcileds", "de": "Offene Abgleiche", "fr": "Rapprochements en attente" },
  "review_button_outstanding": { "en": "Review: {status}; open comments: {comments}, identifications to confirm: {suggestions}, to reconcile: {mentions}", "de": "Prüfung: {status}; offene Kommentare: {comments}, zu bestätigende Identifizierungen: {suggestions}, abzugleichen: {mentions}", "fr": "Révision : {status} ; commentaires ouverts : {comments}, identifications à confirmer : {suggestions}, à rapprocher : {mentions}" },
  "review_confirm_hint": { "en": "Confirm this identification as your own", "de": "Diese Identifizierung als eigene bestätigen", "fr": "Confirmer cette identification comme la vôtre" },
  "review_uris_not_given": { "en": "URIs (given only when there is one candidate): {uris}", "de": "URIs (nur bei einem einzigen Kandidaten übertragen): {uris}", "fr": "URI (données seulement s’il n’y a qu’un candidat) : {uris}" },
  "review_uris_taken": { "en": "Not given (another item has them): {uris}", "de": "Nicht übertragen (gehören schon zu einem anderen Eintrag): {uris}", "fr": "Non données (un autre élément les a) : {uris}" },
  "review_not_saved": { "en": "This is not in the saved document (any more). Save the document first.", "de": "Das ist (noch) nicht im gespeicherten Dokument. Speichern Sie das Dokument zuerst.", "fr": "Ceci n’est pas (ou plus) dans le document enregistré. Enregistrez d’abord le document." },
  "review_mention_label": { "en": "What the source calls it", "de": "Wie die Quelle es nennt", "fr": "Comment la source le nomme" },
  "review_mention_type": { "en": "What kind of thing it is", "de": "Um welche Art es sich handelt", "fr": "De quel genre il s’agit" },
  "review_reconciliations_title": { "en": "Mentions to reconcile", "de": "Abzugleichende Erwähnungen", "fr": "Mentions à rapprocher" },

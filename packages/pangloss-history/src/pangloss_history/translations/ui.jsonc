// The fixed text of the interface module of pangloss_history (the slots of its pages): {"key": {"language": "text"}}.
// Read for every installed app, after the interface's own; a project changes or adds a language in its own
// translations/ui.jsonc.
{
  "history_title": { "en": "History", "de": "Verlauf", "fr": "Historique" },
  "history_problem_some_fields": { "en": "Some fields", "de": "Einige Felder", "fr": "Certains champs" },
  "history_problem_removed_field": { "en": "{field} is no longer part of this record, so its old value isn't shown here.", "de": "{field} gehört nicht mehr zu diesem Datensatz, daher wird der alte Wert hier nicht gezeigt.", "fr": "{field} ne fait plus partie de cet enregistrement : son ancienne valeur n’est donc pas affichée ici." },
  "history_problem_removed_fields": { "en": "{fields} are no longer part of this record, so their old values aren't shown here.", "de": "{fields} gehören nicht mehr zu diesem Datensatz, daher werden die alten Werte hier nicht gezeigt.", "fr": "{fields} ne font plus partie de cet enregistrement : leurs anciennes valeurs ne sont donc pas affichées ici." },
  "history_problem_missing_required": { "en": "{field} is now required, but this version has nothing in it.", "de": "{field} ist jetzt ein Pflichtfeld, aber diese Version enthält dort nichts.", "fr": "{field} est désormais obligatoire, mais cette version n’y contient rien." },
  "history_problem_missing_required_many": { "en": "{fields} are now required, but this version has nothing in them.", "de": "{fields} sind jetzt Pflichtfelder, aber diese Version enthält dort nichts.", "fr": "{fields} sont désormais obligatoires, mais cette version n’y contient rien." },
  "history_problem_model_removed": { "en": "Records of the kind {field} no longer exist, so this part can't be brought back.", "de": "Datensätze der Art {field} gibt es nicht mehr, daher kann dieser Teil nicht wiederhergestellt werden.", "fr": "Les enregistrements du type {field} n’existent plus : cette partie ne peut donc pas être rétablie." },
  "history_problem_models_removed": { "en": "Records of the kinds {fields} no longer exist, so these parts can't be brought back.", "de": "Datensätze der Arten {fields} gibt es nicht mehr, daher können diese Teile nicht wiederhergestellt werden.", "fr": "Les enregistrements des types {fields} n’existent plus : ces parties ne peuvent donc pas être rétablies." },
  "history_problem_type_changed": { "en": "{field} now holds a different kind of value, and the old one doesn't fit it.", "de": "{field} enthält jetzt eine andere Art von Wert, und der alte passt nicht dazu.", "fr": "{field} contient désormais un autre type de valeur, et l’ancienne n’y correspond pas." },
  "history_problem_types_changed": { "en": "{fields} now hold different kinds of value, and the old ones don't fit.", "de": "{fields} enthalten jetzt andere Arten von Werten, und die alten passen nicht dazu.", "fr": "{fields} contiennent désormais d’autres types de valeurs, et les anciennes n’y correspondent pas." },
  "history_problem_reference_not_allowed": { "en": "{field} links to something it is no longer allowed to link to.", "de": "{field} verweist auf etwas, worauf es nicht mehr verweisen darf.", "fr": "{field} renvoie à quelque chose auquel il ne peut plus renvoyer." },
  "history_problem_references_not_allowed": { "en": "{fields} link to things they are no longer allowed to link to.", "de": "{fields} verweisen auf etwas, worauf sie nicht mehr verweisen dürfen.", "fr": "{fields} renvoient à des choses auxquelles ils ne peuvent plus renvoyer." },
  "history_problem_cardinality_changed": { "en": "{field} now takes only one value, but this version has several.", "de": "{field} nimmt jetzt nur einen Wert, aber diese Version hat mehrere.", "fr": "{field} n’accepte plus qu’une seule valeur, mais cette version en a plusieurs." },
  "history_problem_cardinalities_changed": { "en": "{fields} now take only one value each, but this version has several.", "de": "{fields} nehmen jetzt nur je einen Wert, aber diese Version hat mehrere.", "fr": "{fields} n’acceptent plus qu’une seule valeur chacun, mais cette version en a plusieurs." },
  "history_problem_validation": { "en": "{field} doesn't have a value that would be accepted today.", "de": "{field} hat keinen Wert, der heute angenommen würde.", "fr": "{field} n’a pas de valeur qui serait acceptée aujourd’hui." },
  "history_problem_validations": { "en": "{fields} don't have values that would be accepted today.", "de": "{fields} haben keine Werte, die heute angenommen würden.", "fr": "{fields} n’ont pas de valeurs qui seraient acceptées aujourd’hui." },
  "history_problem_validation_none": { "en": "Some of it wouldn't be accepted today.", "de": "Manches davon würde heute nicht angenommen.", "fr": "Une partie ne serait pas acceptée aujourd’hui." },
  "history_problem_unsupported": { "en": "{field} was changed in a way that can't yet be applied to old versions.", "de": "{field} wurde auf eine Weise geändert, die sich noch nicht auf alte Versionen anwenden lässt.", "fr": "{field} a été modifié d’une manière qui ne peut pas encore être appliquée aux anciennes versions." },
  "history_problem_unsupported_many": { "en": "{fields} were changed in a way that can't yet be applied to old versions.", "de": "{fields} wurden auf eine Weise geändert, die sich noch nicht auf alte Versionen anwenden lässt.", "fr": "{fields} ont été modifiés d’une manière qui ne peut pas encore être appliquée aux anciennes versions." },
  "history_problem_unsupported_none": { "en": "Since this version, the data was changed in a way that can't yet be applied to old versions.", "de": "Seit dieser Version wurden die Daten auf eine Weise geändert, die sich noch nicht auf alte Versionen anwenden lässt.", "fr": "Depuis cette version, les données ont été modifiées d’une manière qui ne peut pas encore être appliquée aux anciennes versions." },
  "history_problem_hand_written": { "en": "Since this version, the data was changed in a way that can't be followed automatically, so some of it may now mean something different.", "de": "Seit dieser Version wurden die Daten auf eine Weise geändert, die sich nicht automatisch nachvollziehen lässt; manches kann jetzt etwas anderes bedeuten.", "fr": "Depuis cette version, les données ont été modifiées d’une manière qui ne peut pas être suivie automatiquement : une partie peut donc avoir désormais un autre sens." },
  "history_problem_unknown_position": { "en": "It isn't known when this version was saved, so it is shown exactly as it was stored.", "de": "Es ist nicht bekannt, wann diese Version gespeichert wurde, daher wird sie genau so gezeigt, wie sie gespeichert ist.", "fr": "On ne sait pas quand cette version a été enregistrée : elle est donc affichée exactement telle qu’elle a été stockée." },
  "history_not_recorded": { "en": "Not recorded", "de": "Nicht aufgezeichnet", "fr": "Non enregistrée" },
  "history_current": { "en": "Current", "de": "Aktuell", "fr": "Actuelle" },
  "history_compare": { "en": "Every version", "de": "Alle Versionen", "fr": "Toutes les versions" },
  "history_empty": { "en": "Nothing to show", "de": "Nichts anzuzeigen", "fr": "Rien à afficher" },
  "history_back": { "en": "Back to the item", "de": "Zurück zum Eintrag", "fr": "Retour à l’élément" },
  "history_page_title": { "en": "History of {label}", "de": "Verlauf von {label}", "fr": "Historique de {label}" },
  "history_none": { "en": "No versions of this are recorded.", "de": "Davon sind keine Versionen aufgezeichnet.", "fr": "Aucune version n’en est enregistrée." },
  "history_panel": { "en": "History", "de": "Verlauf", "fr": "Historique" },
  "history_compare_all": { "en": "Compare all", "de": "Alle vergleichen", "fr": "Tout comparer" },
  "history_close": { "en": "Close the history", "de": "Verlauf schließen", "fr": "Fermer l’historique" },
  "history_unreadable": { "en": "The history could not be read.", "de": "Der Verlauf konnte nicht gelesen werden.", "fr": "L’historique n’a pas pu être lu." },
  "history_none_why": { "en": "History began after it was last saved: its next save will be the first version. `pangloss history baseline` records what it is now.", "de": "Der Verlauf begann nach dem letzten Speichern: Das nächste Speichern wird die erste Version. `pangloss history baseline` zeichnet den jetzigen Stand auf.", "fr": "L’historique a commencé après le dernier enregistrement : le prochain sera la première version. `pangloss history baseline` enregistre l’état actuel." },
  "history_versions": { "en": "Versions", "de": "Versionen", "fr": "Versions" },
  "history_gap_one": { "en": "Version {version} was not recorded", "de": "Version {version} wurde nicht aufgezeichnet", "fr": "La version {version} n’a pas été enregistrée" },
  "history_gap": { "en": "Versions {from}–{to} were not recorded", "de": "Die Versionen {from}–{to} wurden nicht aufgezeichnet", "fr": "Les versions {from}–{to} n’ont pas été enregistrées" },
  "history_op_create": { "en": "Created", "de": "Erstellt", "fr": "Créé" },
  "history_op_update": { "en": "Edited", "de": "Bearbeitet", "fr": "Modifié" },
  "history_op_restore_from": { "en": "Restored from version {version}", "de": "Aus Version {version} wiederhergestellt", "fr": "Rétabli depuis la version {version}" },
  "history_op_restore": { "en": "Restored", "de": "Wiederhergestellt", "fr": "Rétabli" },
  "history_op_delete": { "en": "Deleted", "de": "Gelöscht", "fr": "Supprimé" },
  "history_op_undelete": { "en": "Undeleted", "de": "Löschen rückgängig gemacht", "fr": "Suppression annulée" },
  "history_op_baseline": { "en": "Recorded as it was", "de": "Im damaligen Stand aufgezeichnet", "fr": "Enregistré tel quel" },
  "history_restore_title": { "en": "Restore version {version}?", "de": "Version {version} wiederherstellen?", "fr": "Rétablir la version {version} ?" },
  "history_restore_undone": { "en": "The work of these versions will be undone", "de": "Die Arbeit dieser Versionen wird rückgängig gemacht", "fr": "Le travail de ces versions sera annulé" },
  "history_restore_unrecorded": { "en": "The latest version ({version}) wasn't recorded in the history, so its changes can't be listed here. They will be undone too.", "de": "Die neueste Version ({version}) wurde nicht im Verlauf aufgezeichnet, daher können ihre Änderungen hier nicht aufgeführt werden. Auch sie werden rückgängig gemacht.", "fr": "La dernière version ({version}) n’a pas été enregistrée dans l’historique : ses modifications ne peuvent donc pas être listées ici. Elles seront annulées elles aussi." },
  "history_restore_changes": { "en": "What will change", "de": "Was sich ändert", "fr": "Ce qui va changer" },
  "history_restore_reading": { "en": "Reading what the item is now…", "de": "Der jetzige Stand wird gelesen…", "fr": "Lecture de l’état actuel…" },
  "history_restore_unreadable": { "en": "The latest version couldn't be read, so what will change can't be listed here: {reason}", "de": "Die neueste Version konnte nicht gelesen werden, daher kann hier nicht aufgeführt werden, was sich ändert: {reason}", "fr": "La dernière version n’a pas pu être lue : ce qui va changer ne peut donc pas être listé ici : {reason}" },
  "history_restore_no_latest": { "en": "No version with content is recorded.", "de": "Es ist keine Version mit Inhalt aufgezeichnet.", "fr": "Aucune version avec un contenu n’est enregistrée." },
  "history_restore_no_changes": { "en": "Nothing: the content is the same as it is now.", "de": "Nichts: Der Inhalt ist derselbe wie jetzt.", "fr": "Rien : le contenu est le même qu’actuellement." },
  "history_mark_added": { "en": "Put back", "de": "Wieder eingefügt", "fr": "Remis" },
  "history_mark_removed": { "en": "Taken out", "de": "Herausgenommen", "fr": "Retiré" },
  "history_mark_changed": { "en": "Changed", "de": "Geändert", "fr": "Modifié" },
  "history_restore_nothing_erased": { "en": "Nothing is erased: the history keeps every version, and this restore can be undone the same way.", "de": "Nichts wird gelöscht: Der Verlauf behält jede Version, und diese Wiederherstellung lässt sich auf dieselbe Weise rückgängig machen.", "fr": "Rien n’est effacé : l’historique garde chaque version, et ce rétablissement peut être annulé de la même façon." },
  "history_restoring": { "en": "Restoring…", "de": "Wird wiederhergestellt…", "fr": "Rétablissement…" },
  "history_restore": { "en": "Restore", "de": "Wiederherstellen", "fr": "Rétablir" },
  "history_version": { "en": "Version {version}", "de": "Version {version}", "fr": "Version {version}" },
  "history_close_version": { "en": "Close this version", "de": "Diese Version schließen", "fr": "Fermer cette version" },
  "history_version_unreadable": { "en": "This version could not be read.", "de": "Diese Version konnte nicht gelesen werden.", "fr": "Cette version n’a pas pu être lue." },
  "history_upgraded": { "en": "This version was saved before some fields were changed. It's shown as it would look today.", "de": "Diese Version wurde gespeichert, bevor einige Felder geändert wurden. Sie wird so gezeigt, wie sie heute aussähe.", "fr": "Cette version a été enregistrée avant que certains champs ne soient modifiés. Elle est affichée telle qu’elle se présenterait aujourd’hui." },
  "history_deleted_since": { "en": "Deleted since this version: {names}. Restoring it brings them back.", "de": "Seit dieser Version gelöscht: {names}. Beim Wiederherstellen werden sie zurückgeholt.", "fr": "Supprimés depuis cette version : {names}. La rétablir les fait revenir." },
  "history_restore_undeletes": { "en": "Deleted since, and brought back by this restore: {names}.", "de": "Seither gelöscht und durch dieses Wiederherstellen zurückgeholt: {names}.", "fr": "Supprimés depuis, et ramenés par ce rétablissement : {names}." },
  "history_cannot_restore": { "en": "This version can't be restored as it is.", "de": "Diese Version kann nicht so, wie sie ist, wiederhergestellt werden.", "fr": "Cette version ne peut pas être rétablie telle quelle." },
  "history_cannot_restore_why": { "en": "Some things have changed since it was saved:", "de": "Seit dem Speichern hat sich einiges geändert:", "fr": "Certaines choses ont changé depuis son enregistrement :" },
  "history_is_current": { "en": "This is the version the item is at now.", "de": "Dies ist die Version, auf der der Eintrag jetzt steht.", "fr": "C’est la version où se trouve actuellement l’élément." },
  "history_restore_hint": { "en": "Restoring writes this as a new version: nothing is erased.", "de": "Wiederherstellen schreibt dies als neue Version: Nichts wird gelöscht.", "fr": "Le rétablissement l’écrit comme une nouvelle version : rien n’est effacé." },
  "history_restore_to": { "en": "Restore to this point", "de": "Bis hierhin wiederherstellen", "fr": "Rétablir jusqu’ici" },
  "history_restored": { "en": "Restored version {version} as version {now}", "de": "Version {version} als Version {now} wiederhergestellt", "fr": "Version {version} rétablie comme version {now}" },
  "history_restore_stale": { "en": "Not restored: it was changed meanwhile. The versions are shown again.", "de": "Nicht wiederhergestellt: Es wurde inzwischen geändert. Die Versionen werden neu angezeigt.", "fr": "Non rétabli : l’élément a été modifié entre-temps. Les versions sont affichées à nouveau." },
  "history_restore_refused": { "en": "Not restored: {reason}", "de": "Nicht wiederhergestellt: {reason}", "fr": "Non rétabli : {reason}" },
  "history_button": { "en": "History", "de": "Verlauf", "fr": "Historique" }
}

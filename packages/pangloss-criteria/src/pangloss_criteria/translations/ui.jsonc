// The fixed text of the interface module of pangloss_criteria (descriptions: the card, the editor, the dialog, the
// summary of criteria, resolving): {"key": {"language": "text"}}. Read for every installed app, after the interface's own; a
// project changes or adds a language in its own translations/ui.jsonc.
{
  // --- the summary of criteria (`describeCriteria`): {field}, {value}, {node} ... are parts of the sentence ---
  "criteria_or": { "en": "or", "de": "oder", "fr": "ou" },
  "criteria_is": { "en": "{field}: {value}", "de": "{field}: {value}", "fr": "{field} : {value}" },
  "criteria_contains_text": { "en": "{field} contains “{value}”", "de": "{field} enthält „{value}“", "fr": "{field} contient « {value} »" },
  "criteria_starts_with": { "en": "{field} starts with “{value}”", "de": "{field} beginnt mit „{value}“", "fr": "{field} commence par « {value} »" },
  "criteria_between": { "en": "{field} between {from} and {to}", "de": "{field} zwischen {from} und {to}", "fr": "{field} entre {from} et {to}" },
  "criteria_one_of": { "en": "{field}: one of {value}", "de": "{field}: eines von {value}", "fr": "{field} : l’un de {value}" },
  "criteria_exists": { "en": "{field} given", "de": "{field} angegeben", "fr": "{field} renseigné" },
  "criteria_missing": { "en": "no {field}", "de": "kein(e) {field}", "fr": "sans {field}" },
  "criteria_through": { "en": " through {wrappers}", "de": " über {wrappers}", "fr": " par {wrappers}" },
  "criteria_via": { "en": " by way of {steps}", "de": " auf dem Weg über {steps}", "fr": " en passant par {steps}" },
  "criteria_via_then": { "en": ", then ", "de": ", dann ", "fr": ", puis " },
  "criteria_not": { "en": "not {conditions}", "de": "nicht {conditions}", "fr": "non {conditions}" },
  "criteria_incoming": { "en": "{relation}: {node}", "de": "{relation}: {node}", "fr": "{relation} : {node}" },
  "criteria_referred_to_by": { "en": "referred to by {node}", "de": "genannt von {node}", "fr": "cité par {node}" },
  "criteria_contains": { "en": "contains {node}", "de": "enthält {node}", "fr": "contient {node}" },
  "criteria_mentions": { "en": "mentions {entities}", "de": "nennt {entities}", "fr": "mentionne {entities}" },
  "criteria_inside": { "en": "inside {spaces}", "de": "in {spaces}", "fr": "dans {spaces}" },
  "criteria_flag": { "en": "{flag}: {value}", "de": "{flag}: {value}", "fr": "{flag} : {value}" },
  "criteria_deleted_entity": { "en": "deleted entity", "de": "gelöschte Entität", "fr": "entité supprimée" },

  // --- the card and the editor ---
  "criteria_quoted": { "en": "“{wording}”", "de": "„{wording}“", "fr": "« {wording} »" },
  "criteria_names_deleted": { "en": "Names a deleted entity", "de": "Nennt eine gelöschte Entität", "fr": "Nomme une entité supprimée" },
  "criteria_no_criteria": { "en": "No criteria yet", "de": "Noch keine Kriterien", "fr": "Pas encore de critères" },
  "criteria_edit": { "en": "Edit the criteria", "de": "Kriterien bearbeiten", "fr": "Modifier les critères" },
  "criteria_not_saved": { "en": "not saved yet", "de": "noch nicht gespeichert", "fr": "pas encore enregistré" },
  "criteria_finding": { "en": "Finding candidates…", "de": "Kandidaten werden gesucht…", "fr": "Recherche des candidats…" },
  "criteria_count_one": { "en": "1 candidate", "de": "1 Kandidat", "fr": "1 candidat" },
  "criteria_count": { "en": "{count} candidates", "de": "{count} Kandidaten", "fr": "{count} candidats" },
  "criteria_updated": { "en": "updated {when}", "de": "aktualisiert {when}", "fr": "mis à jour le {when}" },
  "criteria_too_broad": { "en": "Too broad: {count} found", "de": "Zu weit gefasst: {count} gefunden", "fr": "Trop large : {count} trouvés" },
  "criteria_and_more": { "en": "and {count} more", "de": "und {count} weitere", "fr": "et {count} de plus" },
  "criteria_candidates_of": { "en": "Candidates: {name}", "de": "Kandidaten: {name}", "fr": "Candidats : {name}" },
  "criteria_broken": { "en": "Out of date: {reason}", "de": "Veraltet: {reason}", "fr": "Périmé : {reason}" },
  "criteria_broken_since": {
    "en": "Out of date since migration {migration}",
    "de": "Veraltet seit der Migration {migration}",
    "fr": "Périmé depuis la migration {migration}"
  },
  "criteria_last_known": {
    "en": "the last found: no longer kept up to date",
    "de": "zuletzt gefunden: wird nicht mehr aktualisiert",
    "fr": "les derniers trouvés : plus tenus à jour"
  },

  // --- the dialog ---
  "criteria_wording": { "en": "What the source says", "de": "Was die Quelle sagt", "fr": "Ce que dit la source" },
  "criteria_wording_placeholder": { "en": "N. N., the duke's secretary", "de": "N. N., Sekretär des Herzogs", "fr": "N. N., secrétaire du duc" },
  "criteria_choose_type": { "en": "What is described", "de": "Was beschrieben wird", "fr": "Ce qui est décrit" },
  "criteria_criteria": { "en": "Criteria", "de": "Kriterien", "fr": "Critères" },
  "criteria_criteria_of": { "en": "Criteria: {type}", "de": "Kriterien: {type}", "fr": "Critères : {type}" },
  "criteria_read_only": {
    "en": "These criteria were written with something the form cannot show. They are shown as they are, and only the wording can be changed here.",
    "de": "Diese Kriterien enthalten etwas, das das Formular nicht darstellen kann. Sie werden so gezeigt, wie sie sind; hier lässt sich nur der Wortlaut ändern.",
    "fr": "Ces critères contiennent quelque chose que le formulaire ne sait pas afficher. Ils sont montrés tels quels, et seule la formulation peut être modifiée ici."
  },
  "criteria_result": { "en": "What they find", "de": "Was sie finden", "fr": "Ce qu’ils trouvent" },
  "criteria_need_condition": {
    "en": "Add at least one condition: a description is saved with its criteria.",
    "de": "Mindestens eine Bedingung hinzufügen: eine Beschreibung wird mit ihren Kriterien gespeichert.",
    "fr": "Ajoutez au moins une condition : une description est enregistrée avec ses critères."
  },
  "criteria_found_one": { "en": "1 candidate found", "de": "1 Kandidat gefunden", "fr": "1 candidat trouvé" },
  "criteria_found": { "en": "{count} candidates found", "de": "{count} Kandidaten gefunden", "fr": "{count} candidats trouvés" },
  "criteria_none_yet": {
    "en": "No candidates yet: it will update as data is added",
    "de": "Noch keine Kandidaten: das ändert sich, wenn Daten hinzukommen",
    "fr": "Pas encore de candidats : cela changera à mesure que des données sont ajoutées"
  },
  "criteria_too_broad_preview": {
    "en": "Too broad: {count} found, more than are linked",
    "de": "Zu weit gefasst: {count} gefunden, mehr als verknüpft werden",
    "fr": "Trop large : {count} trouvés, plus qu’il n’en est relié"
  },
  "criteria_done": { "en": "Done", "de": "Fertig", "fr": "Terminé" },
  "criteria_out_of_date": { "en": "Out of date", "de": "Veraltet", "fr": "Périmé" },
  "criteria_broken_explained": {
    "en": "These criteria no longer fit the models, and are not evaluated: the candidates are the last that were found. Correct them, then save the document.",
    "de": "Diese Kriterien passen nicht mehr zu den Modellen und werden nicht ausgewertet: die Kandidaten sind die zuletzt gefundenen. Korrigieren Sie sie und speichern Sie dann das Dokument.",
    "fr": "Ces critères ne correspondent plus aux modèles et ne sont plus évalués : les candidats sont les derniers trouvés. Corrigez-les, puis enregistrez le document."
  },
  "criteria_read_only_broken": {
    "en": "The form can no longer show these criteria: they name what the models no longer have. They are shown as they were stored. Start afresh to write them again.",
    "de": "Das Formular kann diese Kriterien nicht mehr darstellen: sie nennen etwas, das die Modelle nicht mehr haben. Sie werden so gezeigt, wie sie gespeichert wurden. Beginnen Sie neu, um sie wieder anzugeben.",
    "fr": "Le formulaire ne peut plus afficher ces critères : ils nomment ce que les modèles n’ont plus. Ils sont montrés tels qu’ils ont été enregistrés. Recommencez pour les écrire à nouveau."
  },
  "criteria_start_afresh": { "en": "Start afresh", "de": "Neu beginnen", "fr": "Recommencer" },

  // --- the page of the descriptions that are out of date (/criteria/broken), and on /admin ---
  "criteria_broken_title": { "en": "Descriptions out of date", "de": "Veraltete Beschreibungen", "fr": "Descriptions périmées" },
  "criteria_broken_count": { "en": "Out of date: {count}", "de": "Veraltet: {count}", "fr": "Périmées : {count}" },
  "criteria_broken_none": {
    "en": "No description is out of date.",
    "de": "Keine Beschreibung ist veraltet.",
    "fr": "Aucune description n’est périmée."
  },
  "criteria_broken_one": {
    "en": "1 description is out of date.",
    "de": "1 Beschreibung ist veraltet.",
    "fr": "1 description est périmée."
  },
  "criteria_broken_many": {
    "en": "{count} descriptions are out of date.",
    "de": "{count} Beschreibungen sind veraltet.",
    "fr": "{count} descriptions sont périmées."
  },
  "criteria_broken_all": { "en": "List them", "de": "Auflisten", "fr": "Les lister" },
  "criteria_broken_document": { "en": "Document", "de": "Dokument", "fr": "Document" },
  "criteria_since_migration": {
    "en": "since migration {migration}",
    "de": "seit der Migration {migration}",
    "fr": "depuis la migration {migration}"
  },
  "criteria_edit_in_form": { "en": "Edit it in the form", "de": "Im Formular bearbeiten", "fr": "Modifier dans le formulaire" },

  // --- the same one in several places of a document (`same_one`) ---
  "criteria_same_one_as": { "en": "The same one as", "de": "Identisch mit", "fr": "Le même que" },
  "criteria_same_one_placeholder": {
    "en": "Another description in this document…",
    "de": "Eine andere Beschreibung in diesem Dokument…",
    "fr": "Une autre description de ce document…"
  },
  "criteria_same_one_hint": {
    "en": "Or write criteria of its own below: two descriptions with equal criteria are not taken to be one.",
    "de": "Oder unten eigene Kriterien angeben: zwei Beschreibungen mit gleichen Kriterien gelten nicht als eine.",
    "fr": "Ou indiquez ci-dessous des critères propres : deux descriptions aux critères égaux ne sont pas tenues pour une seule."
  },
  "criteria_same_one_missing": {
    "en": "No description in this form holds the criteria",
    "de": "Keine Beschreibung in diesem Formular enthält die Kriterien",
    "fr": "Aucune description de ce formulaire ne contient les critères"
  },
  "criteria_describe_separately": { "en": "Describe separately", "de": "Eigens beschreiben", "fr": "Décrire à part" },
  "criteria_describe_separately_hint": {
    "en": "Give this place criteria of its own, a copy of these: it is no longer said to be the same one",
    "de": "Dieser Stelle eigene Kriterien geben, eine Kopie dieser: sie gilt dann nicht mehr als identisch",
    "fr": "Donner à cet endroit ses propres critères, une copie de ceux-ci : il n’est plus dit le même"
  },
  "criteria_in_places": {
    "en": "in {count} places of this document",
    "de": "an {count} Stellen dieses Dokuments",
    "fr": "à {count} endroits de ce document"
  },
  "criteria_same_one_as_another": {
    "en": "the same one as another description of this document",
    "de": "identisch mit einer anderen Beschreibung dieses Dokuments",
    "fr": "le même qu’une autre description de ce document"
  },

  // --- resolving ("This is…"), and the mark on a candidate's page ---
  "criteria_this_is": { "en": "This is…", "de": "Das ist…", "fr": "C’est…" },
  "criteria_this_is_hint": {
    "en": "Say who it is: one of the candidates takes its place",
    "de": "Sagen, wer es ist: einer der Kandidaten tritt an seine Stelle",
    "fr": "Dire qui c’est : l’un des candidats prend sa place"
  },
  "criteria_this_is_help": {
    "en": "Who it is: the one chosen takes the place of the description, and the document is saved as a new version. The criteria stay in its history.",
    "de": "Wer es ist: der Gewählte tritt an die Stelle der Beschreibung, und das Dokument wird als neue Version gespeichert. Die Kriterien bleiben in seiner Geschichte.",
    "fr": "Qui c’est : celui qui est choisi prend la place de la description, et le document est enregistré comme une nouvelle version. Les critères restent dans son historique."
  },
  "criteria_this_is_the_one": { "en": "This is the one", "de": "Dieser ist es", "fr": "C’est celui-ci" },
  "criteria_no_candidates": { "en": "No candidates", "de": "Keine Kandidaten", "fr": "Aucun candidat" },
  "criteria_no_candidates_to_choose": {
    "en": "There are no candidates to choose from",
    "de": "Es gibt keine Kandidaten zur Auswahl",
    "fr": "Il n’y a aucun candidat à choisir"
  },
  "criteria_resolve_question": {
    "en": "Put this one in the place of the description, and save the document?",
    "de": "Diesen an die Stelle der Beschreibung setzen und das Dokument speichern?",
    "fr": "Mettre celui-ci à la place de la description, et enregistrer le document ?"
  },
  "criteria_resolve": { "en": "Put in its place", "de": "An seine Stelle setzen", "fr": "Mettre à sa place" },
  "criteria_resolved": {
    "en": "{label} is now in the place of the description",
    "de": "{label} steht jetzt an der Stelle der Beschreibung",
    "fr": "{label} est maintenant à la place de la description"
  },
  "criteria_resolved_places": {
    "en": "{label} is now in the {count} places of the description",
    "de": "{label} steht jetzt an den {count} Stellen der Beschreibung",
    "fr": "{label} est maintenant aux {count} endroits de la description"
  },
  "criteria_resolve_all_places": {
    "en": "It is put in all {count} places of this document that are the same one.",
    "de": "Er wird an allen {count} Stellen dieses Dokuments eingesetzt, die identisch sind.",
    "fr": "Il est mis aux {count} endroits de ce document qui sont le même."
  },
  "criteria_resolve_every_place": {
    "en": "It is put in every place of this document that is the same one.",
    "de": "Er wird an jeder Stelle dieses Dokuments eingesetzt, die identisch ist.",
    "fr": "Il est mis à chaque endroit de ce document qui est le même."
  },
  "criteria_resolve_refused": { "en": "Not resolved: {reason}", "de": "Nicht aufgelöst: {reason}", "fr": "Non résolu : {reason}" },
  "criteria_identified_as_candidate": {
    "en": "identified as candidate",
    "de": "als Kandidat identifiziert",
    "fr": "identifié comme candidat"
  },

  // --- shared descriptions: "Start from", the offer to share, the head of the dialog, and the page of one ---
  "criteria_start_from": { "en": "Start from", "de": "Ausgehen von", "fr": "Partir de" },
  "criteria_start_from_filter": { "en": "Find a shared description", "de": "Gemeinsame Beschreibung suchen", "fr": "Chercher une description partagée" },
  "criteria_start_from_none": { "en": "No shared description has that in its label.", "de": "Keine gemeinsame Beschreibung hat das in ihrer Bezeichnung.", "fr": "Aucune description partagée n’a cela dans son libellé." },
  "criteria_used_by_hint": { "en": "How many mentions cite it", "de": "Wie viele Erwähnungen sie zitieren", "fr": "Combien de mentions la citent" },
  "criteria_used_by_one": { "en": "1 mention", "de": "1 Erwähnung", "fr": "1 mention" },
  "criteria_used_by": { "en": "{count} mentions", "de": "{count} Erwähnungen", "fr": "{count} mentions" },
  "criteria_use": { "en": "Use", "de": "Verwenden", "fr": "Utiliser" },
  "criteria_use_hint": { "en": "Cite it: what it says holds here, and a correction of it reaches this mention", "de": "Zitieren: was sie sagt, gilt hier, und eine Korrektur erreicht diese Erwähnung", "fr": "La citer : ce qu’elle dit vaut ici, et une correction atteint cette mention" },
  "criteria_copy": { "en": "Copy", "de": "Kopieren", "fr": "Copier" },
  "criteria_copy_hint": { "en": "Copy its criteria into this mention, with no link to it", "de": "Ihre Kriterien in diese Erwähnung kopieren, ohne Verbindung zu ihr", "fr": "Copier ses critères dans cette mention, sans lien avec elle" },
  "criteria_shared_description": { "en": "The shared description", "de": "Die gemeinsame Beschreibung", "fr": "La description partagée" },
  "criteria_shared_missing": { "en": "The shared description it cites cannot be read.", "de": "Die zitierte gemeinsame Beschreibung kann nicht gelesen werden.", "fr": "La description partagée qu’elle cite ne peut pas être lue." },
  "criteria_and_also": { "en": "And also, for this mention: {type}", "de": "Und außerdem, für diese Erwähnung: {type}", "fr": "Et aussi, pour cette mention : {type}" },
  "criteria_stop_using": { "en": "Stop using", "de": "Nicht mehr verwenden", "fr": "Ne plus utiliser" },
  "criteria_stop_using_hint": { "en": "Cite it no longer: the conditions above are then this mention's criteria", "de": "Nicht mehr zitieren: die Bedingungen oben sind dann die Kriterien dieser Erwähnung", "fr": "Ne plus la citer : les conditions ci-dessus sont alors les critères de cette mention" },
  "criteria_shared_updated_one": { "en": "1 other document now cites it.", "de": "1 anderes Dokument zitiert sie jetzt.", "fr": "1 autre document la cite maintenant." },
  "criteria_shared_updated": { "en": "{count} other documents now cite it.", "de": "{count} andere Dokumente zitieren sie jetzt.", "fr": "{count} autres documents la citent maintenant." },
  "criteria_shared_this_one": { "en": "This one cites it when it is saved.", "de": "Dieses zitiert sie, sobald es gespeichert ist.", "fr": "Celui-ci la cite une fois enregistré." },
  "criteria_shared_failed": { "en": "Not changed, and still with criteria of their own:", "de": "Nicht geändert, weiterhin mit eigenen Kriterien:", "fr": "Non modifiés, toujours avec leurs propres critères :" },
  "criteria_and_more_documents": { "en": "and {count} more", "de": "und {count} weitere", "fr": "et {count} de plus" },
  "criteria_similar_one": { "en": "The same criteria are used in 1 other document", "de": "Dieselben Kriterien werden in 1 anderen Dokument verwendet", "fr": "Les mêmes critères sont utilisés dans 1 autre document" },
  "criteria_similar": { "en": "The same criteria are used in {count} other documents", "de": "Dieselben Kriterien werden in {count} anderen Dokumenten verwendet", "fr": "Les mêmes critères sont utilisés dans {count} autres documents" },
  "criteria_share": { "en": "Make them one shared description…", "de": "Daraus eine gemeinsame Beschreibung machen…", "fr": "En faire une description partagée…" },
  "criteria_share_explained_one": { "en": "This makes a shared description of these criteria, and changes 1 other document, which may be someone else's: it gets a new version, in which its mention cites the shared description instead of holding the criteria itself. This mention cites it too, once you save this document.", "de": "Dies macht aus diesen Kriterien eine gemeinsame Beschreibung und ändert 1 anderes Dokument, das jemand anderem gehören kann: es erhält eine neue Version, in der seine Erwähnung die gemeinsame Beschreibung zitiert, statt die Kriterien selbst zu enthalten. Diese Erwähnung zitiert sie ebenfalls, sobald Sie dieses Dokument speichern.", "fr": "Ceci fait de ces critères une description partagée et modifie 1 autre document, qui peut appartenir à quelqu’un d’autre : il reçoit une nouvelle version, dans laquelle sa mention cite la description partagée au lieu de contenir elle-même les critères. Cette mention la cite aussi, une fois ce document enregistré." },
  "criteria_share_explained": { "en": "This makes a shared description of these criteria, and changes {count} other documents, which may be other people's: each gets a new version, in which its mention cites the shared description instead of holding the criteria itself. This mention cites it too, once you save this document.", "de": "Dies macht aus diesen Kriterien eine gemeinsame Beschreibung und ändert {count} andere Dokumente, die anderen gehören können: jedes erhält eine neue Version, in der seine Erwähnung die gemeinsame Beschreibung zitiert, statt die Kriterien selbst zu enthalten. Diese Erwähnung zitiert sie ebenfalls, sobald Sie dieses Dokument speichern.", "fr": "Ceci fait de ces critères une description partagée et modifie {count} autres documents, qui peuvent appartenir à d’autres : chacun reçoit une nouvelle version, dans laquelle sa mention cite la description partagée au lieu de contenir elle-même les critères. Cette mention la cite aussi, une fois ce document enregistré." },
  "criteria_share_label": { "en": "Label of the shared description", "de": "Bezeichnung der gemeinsamen Beschreibung", "fr": "Libellé de la description partagée" },
  "criteria_share_label_placeholder": { "en": "Maximilian's secretary", "de": "Maximilians Sekretär", "fr": "Le secrétaire de Maximilien" },
  "criteria_share_confirm_one": { "en": "Change 1 document and share", "de": "1 Dokument ändern und teilen", "fr": "Modifier 1 document et partager" },
  "criteria_share_confirm": { "en": "Change {count} documents and share", "de": "{count} Dokumente ändern und teilen", "fr": "Modifier {count} documents et partager" },
  "criteria_description_used_by_none": { "en": "A description that no mention uses yet.", "de": "Eine Beschreibung, die noch keine Erwähnung verwendet.", "fr": "Une description qu’aucune mention n’utilise encore." },
  "criteria_description_used_by_one": { "en": "A description used by 1 mention.", "de": "Eine Beschreibung, die von 1 Erwähnung verwendet wird.", "fr": "Une description utilisée par 1 mention." },
  "criteria_description_used_by": { "en": "A description used by {count} mentions.", "de": "Eine Beschreibung, die von {count} Erwähnungen verwendet wird.", "fr": "Une description utilisée par {count} mentions." },
  "criteria_description_not_one": { "en": "It does not say that they are one and the same.", "de": "Sie besagt nicht, dass sie identisch sind.", "fr": "Elle ne dit pas qu’ils ne font qu’un." },
  "criteria_description_no_mentions": { "en": "No mention cites it yet.", "de": "Noch keine Erwähnung zitiert sie.", "fr": "Aucune mention ne la cite encore." },
  "criteria_description_own_conditions": { "en": "And also", "de": "Und außerdem", "fr": "Et aussi" },
  "criteria_description_candidates": { "en": "What the criteria find", "de": "Was die Kriterien finden", "fr": "Ce que trouvent les critères" },
  "criteria_description_candidates_login": { "en": "Log in to see what these criteria find.", "de": "Melden Sie sich an, um zu sehen, was diese Kriterien finden.", "fr": "Connectez-vous pour voir ce que trouvent ces critères." },
  "criteria_description_mentions": { "en": "Mentions", "de": "Erwähnungen", "fr": "Mentions" }
}

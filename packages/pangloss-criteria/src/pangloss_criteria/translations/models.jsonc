// The names of the models of pangloss_criteria in the interface. A project changes them in its own
// `translations/models.jsonc` (its overrides), not here: `pangloss interface translations generate` does not write into
// a package.
{
  "models": {
    "MatchesCriteria": {
      "en": {
        "name": "Matches criteria",
        "plural": "Matches criteria",
        "description": "Someone or something the source describes but does not name: whoever fits the criteria",
        "help": "",
        "fields": {
          "wording": { "name": "Wording", "plural": "", "help": "What the source says" },
          "criteria": { "name": "Criteria", "plural": "", "help": "" },
          "description": { "name": "Shared description", "plural": "", "help": "A shared description this one cites: its criteria hold too, beside those given here" },
          "same_one": { "name": "The same one as", "plural": "", "help": "A mark shared by the places of this document that describe the same one: one of them holds the criteria" },
          "target": { "name": "Candidates", "plural": "", "help": "" },
          "candidate_count": { "name": "Number of candidates", "plural": "", "help": "" },
          "evaluated_when": { "name": "Evaluated", "plural": "", "help": "" },
          "broken": { "name": "Out of date", "plural": "", "help": "" },
          "broken_since": { "name": "Out of date since migration", "plural": "", "help": "" }
        }
      },
      "de": {
        "name": "Erfüllt Kriterien",
        "plural": "Erfüllt Kriterien",
        "description": "Jemand oder etwas, das die Quelle beschreibt, aber nicht nennt: wer auf die Kriterien passt",
        "help": "",
        "fields": {
          "wording": { "name": "Wortlaut", "plural": "", "help": "Was die Quelle sagt" },
          "criteria": { "name": "Kriterien", "plural": "", "help": "" },
          "description": { "name": "Gemeinsame Beschreibung", "plural": "", "help": "Eine gemeinsame Beschreibung, die diese zitiert: ihre Kriterien gelten auch, neben den hier angegebenen" },
          "same_one": { "name": "Identisch mit", "plural": "", "help": "Eine Markierung, die die Stellen dieses Dokuments teilen, die denselben beschreiben: eine von ihnen enthält die Kriterien" },
          "target": { "name": "Kandidaten", "plural": "", "help": "" },
          "candidate_count": { "name": "Zahl der Kandidaten", "plural": "", "help": "" },
          "evaluated_when": { "name": "Ausgewertet", "plural": "", "help": "" },
          "broken": { "name": "Veraltet", "plural": "", "help": "" },
          "broken_since": { "name": "Veraltet seit Migration", "plural": "", "help": "" }
        }
      },
      "fr": {
        "name": "Répond aux critères",
        "plural": "Répond aux critères",
        "description": "Quelqu’un ou quelque chose que la source décrit sans le nommer : quiconque répond aux critères",
        "help": "",
        "fields": {
          "wording": { "name": "Formulation", "plural": "", "help": "Ce que dit la source" },
          "criteria": { "name": "Critères", "plural": "", "help": "" },
          "description": { "name": "Description partagée", "plural": "", "help": "Une description partagée que celle-ci cite : ses critères valent aussi, à côté de ceux donnés ici" },
          "same_one": { "name": "Le même que", "plural": "", "help": "Une marque que partagent les endroits de ce document qui décrivent le même : l’un d’eux contient les critères" },
          "target": { "name": "Candidats", "plural": "", "help": "" },
          "candidate_count": { "name": "Nombre de candidats", "plural": "", "help": "" },
          "evaluated_when": { "name": "Évalué", "plural": "", "help": "" },
          "broken": { "name": "Périmé", "plural": "", "help": "" },
          "broken_since": { "name": "Périmé depuis la migration", "plural": "", "help": "" }
        }
      }
    },
    "Description": {
        "en": {
          "name": "Shared description",
          "plural": "Shared descriptions",
          "description": "Criteria that several mentions share: each that cites it is whoever fits them (and its own conditions). It does not say that they are one and the same",
          "help": "",
          "fields": {
            "criteria": {
              "name": "Criteria",
              "plural": "",
              "help": ""
            }
          }
        },
        "de": {
          "name": "Gemeinsame Beschreibung",
          "plural": "Gemeinsame Beschreibungen",
          "description": "Kriterien, die mehrere Erwähnungen teilen: jede, die sie zitiert, ist, wer auf sie passt (und auf ihre eigenen Bedingungen). Sie besagt nicht, dass sie identisch sind",
          "help": "",
          "fields": {
            "criteria": {
              "name": "Kriterien",
              "plural": "",
              "help": ""
            }
          }
        },
        "fr": {
          "name": "Description partagée",
          "plural": "Descriptions partagées",
          "description": "Des critères que plusieurs mentions partagent : chacune qui la cite est quiconque y répond (et à ses propres conditions). Elle ne dit pas qu’ils ne font qu’un",
          "help": "",
          "fields": {
            "criteria": {
              "name": "Critères",
              "plural": "",
              "help": ""
            }
          }
        }
      }
  }
}

// The fixed text of the interface module of pangloss_zotero: {"key": {"language": "text"}}.
// Read for every installed app, after the interface's own; a project changes or adds a language in its own
// translations/ui.jsonc.
{
  "zotero_from": { "en": "From Zotero", "de": "Aus Zotero", "fr": "Depuis Zotero" },
  "zotero_from_title": { "en": "A new {type} from an item of the Zotero library", "de": "Neu: {type} aus einem Eintrag der Zotero-Bibliothek", "fr": "Nouveau : {type} à partir d’un élément de la bibliothèque Zotero" },
  "zotero_from_note": { "en": "The item becomes this {type}, and stays an item of the library: what refers to it is kept. Save makes it so.", "de": "Der Eintrag wird zu diesem Datensatz ({type}) und bleibt ein Eintrag der Bibliothek: Was auf ihn verweist, bleibt erhalten. Speichern führt es aus.", "fr": "L’élément devient cet enregistrement ({type}) et reste un élément de la bibliothèque : ce qui y renvoie est conservé. L’enregistrement l’applique." },
  "zotero_based_on": { "en": "Based on", "de": "Beruht auf", "fr": "Fondé sur" },
  "zotero_not_based_on": { "en": "Not based on it", "de": "Nicht darauf beruhen", "fr": "Ne pas s’en servir" },
  "zotero_not_read": { "en": "The item could not be read: {reason}", "de": "Der Eintrag konnte nicht gelesen werden: {reason}", "fr": "L’élément n’a pas pu être lu : {reason}" },
  "zotero_search": { "en": "Find an item of the Zotero library", "de": "Einen Eintrag der Zotero-Bibliothek suchen", "fr": "Chercher un élément de la bibliothèque Zotero" },
  "zotero_address": { "en": "Or the item's Zotero address", "de": "Oder die Zotero-Adresse des Eintrags", "fr": "Ou l’adresse Zotero de l’élément" },
  "zotero_link_address": { "en": "Link", "de": "Verknüpfen", "fr": "Lier" },
  "zotero_link": { "en": "Link to Zotero", "de": "Mit Zotero verknüpfen", "fr": "Lier à Zotero" },
  "zotero_link_title": { "en": "Link to an item of the Zotero library", "de": "Mit einem Eintrag der Zotero-Bibliothek verknüpfen", "fr": "Lier à un élément de la bibliothèque Zotero" },
  "zotero_link_note": { "en": "This takes the item's fields and address. If the item is already in the database, the two become one: the one that something refers to is kept.", "de": "Dies übernimmt die Felder und die Adresse des Eintrags. Ist der Eintrag schon in der Datenbank, werden beide eins: Erhalten bleibt der, auf den etwas verweist.", "fr": "Cela reprend les champs et l’adresse de l’élément. Si l’élément est déjà dans la base, les deux n’en font plus qu’un : celui auquel quelque chose renvoie est conservé." },
  "zotero_linked": { "en": "Linked to the Zotero item", "de": "Mit dem Zotero-Eintrag verknüpft", "fr": "Lié à l’élément Zotero" },
  "zotero_link_refused": { "en": "Not linked: {reason}", "de": "Nicht verknüpft: {reason}", "fr": "Non lié : {reason}" },
  "zotero_unlink": { "en": "Unlink from Zotero", "de": "Von Zotero lösen", "fr": "Délier de Zotero" },
  "zotero_unlink_title": { "en": "Unlink from the Zotero item?", "de": "Vom Zotero-Eintrag lösen?", "fr": "Délier de l’élément Zotero ?" },
  "zotero_unlink_note": { "en": "This keeps its own fields and what refers to it, and loses the Zotero fields. The item becomes an entry of its own again.", "de": "Die eigenen Felder und was darauf verweist bleiben, die Zotero-Felder fallen weg. Der Eintrag wird wieder ein eigener Datensatz.", "fr": "Ses propres champs et ce qui y renvoie sont conservés ; les champs Zotero disparaissent. L’élément redevient un enregistrement à part." },
  "zotero_unlinked": { "en": "Unlinked: the Zotero item is “{label}” again", "de": "Gelöst: Der Zotero-Eintrag ist wieder „{label}“", "fr": "Délié : l’élément Zotero est de nouveau « {label} »" },
  "zotero_unlink_refused": { "en": "Not unlinked: {reason}", "de": "Nicht gelöst: {reason}", "fr": "Non délié : {reason}" },
  "zotero_unsaved_lost": { "en": "Changes in the form that are not saved are lost.", "de": "Nicht gespeicherte Änderungen im Formular gehen verloren.", "fr": "Les modifications non enregistrées du formulaire sont perdues." }
}

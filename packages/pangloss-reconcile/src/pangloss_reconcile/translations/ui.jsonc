  "reconcile_learn_count_undisplayed": { "en": "with nothing displayed", "de": "ohne angezeigte Vorschläge", "fr": "sans suggestion affichée" },
  // (the admin job that leaves the documents stored for the worker that suggests, its option and its counts)
  "reconcile_suggest_title": { "en": "Suggest identifications in stored documents", "de": "Identifizierungen in gespeicherten Dokumenten vorschlagen", "fr": "Suggérer des identifications dans les documents enregistrés" },

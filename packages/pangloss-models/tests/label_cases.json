{
  "models": {
    "Amount": {
      "kind": "Embedded",
      "requireLabel": false,
      "labelTemplate": {
        "alternatives": [
          "{number} {unit}"
        ]
      },
      "fields": [
        {
          "name": "number",
          "key": "number",
          "kind": "literal"
        },
        {
          "name": "unit",
          "key": "unit",
          "kind": "literal"
        }
      ]
    },
    "Bequest": {
      "kind": "Document",
      "requireLabel": true,
      "labelTemplate": {
        "alternatives": [
          "{item}[ ({amount})] to {recipient}"
        ]
      },
      "fields": [
        {
          "name": "item",
          "key": "item",
          "kind": "literal"
        },
        {
          "name": "recipient",
          "key": "recipient",
          "kind": "relation"
        },
        {
          "name": "amount",
          "key": "amount",
          "kind": "embedded"
        }
      ]
    },
    "Identification": {
      "kind": "ReifiedRelation",
      "requireLabel": false,
      "labelTemplate": null,
      "fields": [
        {
          "name": "target",
          "key": "target",
          "kind": "relation"
        },
        {
          "name": "certainty",
          "key": "certainty",
          "kind": "literal"
        }
      ]
    },
    "Person": {
      "kind": "Entity",
      "requireLabel": true,
      "labelTemplate": {
        "alternatives": [
          "{surname}[, {forename}]",
          "{forename}"
        ]
      },
      "fields": [
        {
          "name": "forename",
          "key": "forename",
          "kind": "literal"
        },
        {
          "name": "surname",
          "key": "surname",
          "kind": "literal"
        }
      ]
    },
    "Place": {
      "kind": "Entity",
      "requireLabel": true,
      "labelTemplate": null,
      "fields": []
    },
    "Plain": {
      "kind": "Document",
      "requireLabel": true,
      "labelTemplate": null,
      "fields": [
        {
          "name": "text",
          "key": "text",
          "kind": "literal"
        }
      ]
    },
    "Summary": {
      "kind": "Document",
      "requireLabel": true,
      "labelTemplate": {
        "alternatives": [
          "[{will.bequests|each(\"{item} → {recipient}\")|join(\"; \")}][ | first: {will.bequests|first}][ | {will.testator|default(\"?\")}]"
        ]
      },
      "fields": [
        {
          "name": "will",
          "key": "will",
          "kind": "relation"
        }
      ]
    },
    "Will": {
      "kind": "Document",
      "requireLabel": true,
      "labelTemplate": {
        "alternatives": [
          "Will of {testator}[ at {made_at}][: {bequests|count} bequests][, witnessed by {witnesses|join(\", \", \" and \")}]",
          "Will of {testator}"
        ]
      },
      "fields": [
        {
          "name": "testator",
          "key": "testator",
          "kind": "relation"
        },
        {
          "name": "made_at",
          "key": "madeAt",
          "kind": "relation"
        },
        {
          "name": "bequests",
          "key": "bequests",
          "kind": "relation"
        },
        {
          "name": "witnesses",
          "key": "witnesses",
          "kind": "relation"
        }
      ]
    },
    "Witnesses": {
      "kind": "Conjunction",
      "requireLabel": false,
      "labelTemplate": null,
      "fields": [
        {
          "name": "witness",
          "key": "witness",
          "kind": "relation"
        },
        {
          "name": "also",
          "key": "also",
          "kind": "relation"
        }
      ]
    },
    "Witnessing": {
      "kind": "Document",
      "requireLabel": true,
      "labelTemplate": {
        "alternatives": [
          "{witnesses|each(\"{target} [({certainty})]\")|join(\"; \")}[ — {witnesses|count} in all]"
        ]
      },
      "fields": [
        {
          "name": "witnesses",
          "key": "witnesses",
          "kind": "relation"
        }
      ]
    }
  },
